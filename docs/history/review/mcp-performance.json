    "command": "python3 tests/benchmark_mcp.py --output mcp-performance.json",
    "prototype_patch": "--- a/qff_mcp/qff_mcp.py\n+++ b/qff_mcp/qff_mcp.py\n@@ -13,6 +13,8 @@\n public site URL (e.g. https://delirious6423.github.io/quant-fidelity-frontier/). The cache refreshes every five minutes.\n \"\"\"\n import json, math, os, re, sys, urllib.request\n+import hashlib\n+from collections import OrderedDict\n import threading\n import time\n from pathlib import Path, PurePosixPath\n@@ -44,6 +46,9 @@\n                    \"do not verify matching evaluation settings. Independent reports are retained without ranking, \"\n                    \"averaging or converting score units. File size is not total VRAM usage.\")\n _cache = {}\n+_comparison_cache = OrderedDict()\n+_comparison_cache_bytes = 0\n+MAX_COMPARISON_CACHE_BYTES = 8_000_000\n _cache_lock = threading.RLock()\n _loaded_at = None\n REFRESH_SECONDS = 300\n@@ -147,6 +152,8 @@\n             # A refresh failure never replaces the last valid snapshot or marks\n             # it fresh. The request raises and the next call retries.\n             _cache.clear()\n+            _comparison_cache.clear()\n+            globals()['_comparison_cache_bytes'] = 0\n             _cache['m'] = manifest\n             _loaded_at = time.monotonic()\n         return _cache[\"m\"]\n@@ -178,7 +185,31 @@\n             \"unknowns\": [\"comparison_engine\"], \"ranking_permitted\": False}\n \n def _comparison(points, metric=None):\n-    return classify_group(points, metric=metric) if classify_group else _unavailable_comparison()\n+    global _comparison_cache_bytes\n+    if not classify_group:\n+        return _unavailable_comparison()\n+    # Content identity covers every field the evidence classifier consumes,\n+    # including order/multiplicity. Never trust a serialized permission flag.\n+    evidence = [(p.get('protocol', {}), p.get('claim_provenance', {})) for p in points]\n+    fingerprint = hashlib.sha256(json.dumps(evidence, sort_keys=True,\n+        ensure_ascii=False, separators=(',', ':')).encode()).digest()\n+    key = (classify_group, metric, fingerprint)\n+    with _cache_lock:\n+        if key in _comparison_cache:\n+            _comparison_cache.move_to_end(key)\n+            return json.loads(_comparison_cache[key])\n+    result = classify_group(points, metric=metric)\n+    encoded = json.dumps(result, ensure_ascii=False, separators=(',', ':')).encode()\n+    if len(encoded) <= MAX_COMPARISON_CACHE_BYTES:\n+        with _cache_lock:\n+            if key in _comparison_cache:\n+                _comparison_cache_bytes -= len(_comparison_cache.pop(key))\n+            _comparison_cache[key] = encoded\n+            _comparison_cache_bytes += len(encoded)\n+            while len(_comparison_cache) > 512 or _comparison_cache_bytes > MAX_COMPARISON_CACHE_BYTES:\n+                _, expired = _comparison_cache.popitem(last=False)\n+                _comparison_cache_bytes -= len(expired)\n+    return result\n \n def _set_comparison(S, metric):\n     # Recompute from evidence, never trust a cached/legacy comparable boolean.\n",
